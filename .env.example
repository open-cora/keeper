# Postgres
DATABASE_URL=postgresql://keeper:keeper@localhost:5433/keeper

# App
APP_ENV=local
LOG_LEVEL=INFO

# Connection pool
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# HTTP
# Default 1 MiB. JSON command bodies are small. The application middleware is
# defense in depth; production deployments should also configure body limits at
# the reverse proxy for transport-layer rejection.
# MAX_REQUEST_BODY_SIZE_BYTES=1048576

# Authentication
# When false (the default), the API accepts a client-supplied X-Principal-Id
# header, which is a development convenience and nothing more: anyone can claim
# any principal. Production must set this true AND front the API with a proxy
# that authenticates the caller, strips any client-supplied X-Principal-Id, and
# sets the verified one. APP_ENV=prod refuses to boot without it.
# REQUIRE_AUTHENTICATED_PRINCIPAL=true

# Authorization: the policy this deployment authorizes against. Unset means
# every command is permitted, which is correct for local work and for the
# bootstrap, and which APP_ENV=prod refuses to boot with.
#
# Bootstrap in this order, before setting it: register the administrator as
# an actor, then author a policy naming the id that registration minted. A
# permission naming a principal with no actor behind it authorizes nothing,
# and once this is set, both of those are commands the policy has to permit.
# AUTHZ_POLICY_ID=00000000-0000-0000-0000-000000000000

# Edge auth: identity providers, as JSON. Unset means no bearer-token
# verification is wired and the header path above is the only one.
# Each entry declares an issuer and either a JWKS URL (local JWT signature
# verification) or an introspection endpoint (remote token validation).
# IDENTITY_PROVIDERS=[{"issuer": "https://idp.example.org", "jwks_url": "https://idp.example.org/.well-known/jwks.json", "audience": "keeper"}]

# Database schema agreement
# The keeper refuses to start when the applied migration version is not the one the
# build expects. Migrations are applied out of band (make migrate-apply) and the
# runtime image ships no way to apply them, so restoring a backup taken before a
# migration leaves a database older than the code. The refusal names both
# versions and the remedy; the two directions differ, because a database BEHIND
# the build is fixed by applying migrations while one AHEAD of it cannot be
# (forward-only leaves nothing to apply) and needs the matching image instead.
#
# Setting this true boots anyway, with every append to the event log refused and
# reads still working, so a restored database can be READ without risking an
# append-only history that cannot be corrected afterwards. /readyz reports
# "schema": "degraded" throughout.
#
# Scope it honestly: this protects the EVENT LOG, not every write.
# ALLOW_SCHEMA_VERSION_MISMATCH=true

# Event signing
# The in-memory signer holds its key in process memory and loses it on restart,
# so signatures it produced cannot be verified by the next process. Acceptable
# locally, never in production; a production-tier APP_ENV refuses to boot with it.
# ALLOW_INSECURE_INMEMORY_SIGNING=true

# Idempotency
# IDEMPOTENCY_TTL_HOURS=24
# IDEMPOTENCY_LOCK_STALE_SECONDS=60

# Observability (OpenTelemetry)
# OTEL_EXPORTER=none        # otlp | console | none
# OTEL_SERVICE_NAME=keeper
# OTEL_SAMPLER_RATIO=1.0

# Language model port
# Off by default. No subscriber exists in the baseline; this is the chassis
# seam, wired so the first domain that needs it does not have to add plumbing.
# LLM_ENABLED=true
# ANTHROPIC_API_KEY=

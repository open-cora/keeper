# The keeper's HTTP surface. Written by install.sh from this template; see
# keeper-postgres.container.in for why ConditionHost is here and why the
# tracked copy names no host.

[Unit]
Description=Keeper API
ConditionHost=@DEPLOY_HOST@
# keeper-postgres.service is generated by quadlet from the .container file.
After=keeper-postgres.service
Wants=keeper-postgres.service

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
EnvironmentFile=@CORA_ROOT@/etc/keeper.env

# `After=` orders the start and does not wait for readiness, so without this
# the API races initdb on a first boot and crash-loops until Postgres wins.
# Asking the container rather than probing a port keeps this honest: an open
# port is not the same as a database accepting queries.
ExecStartPre=/bin/bash -c 'for _ in $(seq 1 60); do podman exec keeper-postgres pg_isready -U keeper -d keeper >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'

# One worker, deliberately. The application runs its projection workers in
# process, and a second uvicorn worker would run a second copy of each
# against the same bookmarks. Scaling the HTTP surface means separating the
# projection runner first, which this deployment does not do.
#
# Bound to loopback because this deployment sets no production-tier APP_ENV
# and therefore authenticates nobody: the principal comes from a request
# header anyone could send. Widening this address and configuring
# authentication are one change, never two, and the environment file is
# where the other half lives.
ExecStart=@APP_DIR@/.venv/bin/uvicorn keeper.api.main:app --host 127.0.0.1 --port @API_PORT@

Restart=always
RestartSec=15
StandardOutput=append:@CORA_ROOT@/log/keeper.log
StandardError=append:@CORA_ROOT@/log/keeper.log

[Install]
WantedBy=default.target
